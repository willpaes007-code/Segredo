<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Uma surpresa para você</title>
<meta name="description" content="Uma surpresa para você"><meta property="og:title" content="Uma surpresa para você"><meta property="og:description" content="Uma surpresa para você"><meta name="robots" content="noindex,nofollow">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Nunito:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--cream:#f7efde;--champ:#ecdcb8;--champ2:#d9c093;--gold:#c2a15a;--gold2:#a9873f;--sage:#8da58a;--sage2:#6f8a6c;--ink:#4b4030;--serif:'Cormorant Garamond',Georgia,serif;--sans:'Nunito',system-ui,sans-serif;--t:.75s}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{background:radial-gradient(ellipse at 50% 30%,#fbf5e8,#efe2c4 70%,#e4d3ad);color:var(--ink);font-family:var(--sans);overflow:hidden;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
body.warm{background:radial-gradient(ellipse at 50% 25%,#fff3d2,#f3dfae 60%,#e6cf96)}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--sage2);outline-offset:3px}
.tools{position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);right:10px;display:flex;gap:8px;z-index:30}
.tool{min-height:44px;min-width:44px;padding:0 14px;border-radius:22px;border:1px solid var(--champ2);background:rgba(255,250,238,.85);font-size:.85rem}
.scr{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:64px 24px 24px;transition:opacity .8s}
.hide{opacity:0;pointer-events:none;visibility:hidden}
h1,h2{font-family:var(--serif);font-weight:600;line-height:1.2;margin:0}
h1{font-size:clamp(1.7rem,6.4vw,2.5rem);max-width:19ch}
.lead{max-width:30ch;line-height:1.6;font-size:1.05rem;margin:14px 0 22px}
.hint{font-size:.88rem;opacity:.75;margin-top:16px;max-width:30ch}
.btn{min-height:52px;padding:0 30px;border:0;border-radius:30px;background:linear-gradient(#d4b673,var(--gold2));color:#fffaf0;font-weight:600;font-size:1.02rem;box-shadow:0 8px 18px -6px rgba(120,90,30,.55),inset 0 1px 0 rgba(255,255,255,.4);transition:transform .2s}
.btn:active{transform:scale(.97)}
.ghost{background:none;border:1px solid var(--gold);color:var(--gold2);box-shadow:none;font-weight:400}
/* box */
.world{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.bx{--s:min(58vw,250px);--rib:var(--sage);--rib2:var(--sage2);position:absolute;width:var(--s);height:calc(var(--s)*.9);transition:transform var(--t) cubic-bezier(.5,0,.2,1),opacity var(--t),filter var(--t);transform-origin:50% 60%;border:0;background:none;padding:0;cursor:pointer}
.bx.g{--rib:var(--gold);--rib2:var(--gold2)}
.bx.tiny{transform:translateY(-6%) scale(.3);opacity:.0}
.bx.tiny.peek{opacity:1}
.bx.gone{transform:scale(3.6);opacity:0;pointer-events:none}
.shadow{position:absolute;left:6%;right:6%;bottom:-4%;height:12%;background:radial-gradient(ellipse,rgba(70,50,20,.38),transparent 70%)}
.body{position:absolute;left:3%;right:3%;bottom:0;height:62%;border-radius:4px 4px 8px 8px;background:linear-gradient(90deg,#d8bf8e,#f1e3c0 30%,#ead8ad 70%,#cdb27c);box-shadow:inset 0 -14px 22px rgba(120,90,40,.25)}
.body::before{content:"";position:absolute;left:0;right:0;top:0;height:14%;background:linear-gradient(#8a6e3c,#b79a62);opacity:.55;border-radius:4px 4px 0 0}
.body::after{content:"";position:absolute;left:44%;width:12%;top:0;bottom:0;background:linear-gradient(90deg,var(--rib2),var(--rib),var(--rib2))}
.lid{position:absolute;left:0;right:0;bottom:58%;height:26%;border-radius:6px;background:linear-gradient(90deg,#d9c08f,#f6ead0 30%,#efdfb8 70%,#d0b57f);box-shadow:0 8px 12px -4px rgba(90,65,25,.4),inset 0 -5px 8px rgba(120,90,40,.2);transition:transform .55s cubic-bezier(.3,.7,.2,1),opacity .55s;transform-origin:15% 100%}
.lid::after{content:"";position:absolute;left:44%;width:12%;top:0;bottom:0;background:linear-gradient(90deg,var(--rib2),var(--rib),var(--rib2))}
.bow{position:absolute;left:50%;top:-34%;width:44%;height:42%;transform:translateX(-50%);z-index:2;transition:transform .5s ease,opacity .4s}
.bow i{position:absolute;top:8%;width:48%;height:76%;border:7px solid var(--rib);border-radius:50% 50% 50% 50%/70% 70% 40% 40%;box-shadow:inset 0 0 0 2px var(--rib2),0 3px 5px rgba(60,40,10,.25)}
.bow i:first-child{left:0;transform:rotate(-24deg)}.bow i:nth-child(2){right:0;transform:rotate(24deg) scaleX(-1)}
.bow b{position:absolute;left:50%;top:44%;width:20%;height:34%;transform:translateX(-50%);background:linear-gradient(var(--rib),var(--rib2));border-radius:40%;box-shadow:0 2px 4px rgba(60,40,10,.3)}
.bx.open .bow{transform:translate(-50%,-60px) rotate(40deg) scale(.7);opacity:0}
.bx.open .lid{transform:translate(18%,-130%) rotate(14deg);opacity:0}
.bx.open .body::before{opacity:1;background:linear-gradient(#5e4a28,#8b7141)}
.bx:not(.open){animation:breath 4s ease-in-out infinite}
@keyframes breath{50%{transform:translateY(-4px)}}
.bx.tiny,.bx.gone{animation:none}
.tap{position:absolute;left:0;right:0;bottom:calc(50% - var(--s)*.9/2 - 40px);text-align:center;font-size:.9rem;opacity:.7;transition:opacity .4s}
/* card */
.card{position:absolute;left:50%;top:50%;width:min(86vw,360px);transform:translate(-50%,-40%) scale(.5) rotate(-2deg);opacity:0;pointer-events:none;background:linear-gradient(#fffdf6,#fbf3df);border:1px solid var(--champ2);border-radius:6px;padding:28px 24px 22px;text-align:center;box-shadow:0 22px 40px -12px rgba(80,55,15,.45);transition:transform .55s cubic-bezier(.2,.8,.2,1),opacity .4s;z-index:5}
.card.show{transform:translate(-50%,-92%) scale(1) rotate(-.6deg);opacity:1;pointer-events:auto}
.card p{font-family:var(--serif);font-size:clamp(1.3rem,5.4vw,1.6rem);line-height:1.35;margin:0 0 18px}
.card small{display:block;font-size:.95rem;margin:-6px 0 18px;opacity:.8}
/* reveal */
#rev{position:absolute;inset:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:70px 22px 40px;text-align:center;opacity:0;visibility:hidden;transition:opacity 1.6s}
#rev.on{opacity:1;visibility:visible}
.glow{position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 30%,rgba(255,226,150,.65),transparent 62%);opacity:0;transition:opacity 2.4s}
.warm .glow{opacity:1}
.wrap{max-width:420px;margin:0 auto}
.photo{display:block;margin:0 auto;border:0;padding:12px 12px 16px;background:#fffaf0;border-radius:3px;box-shadow:0 22px 38px -10px rgba(80,55,15,.5);transform:translateY(60px) scale(.85) rotate(-3deg);opacity:0;transition:transform 1.8s cubic-bezier(.2,.8,.2,1),opacity 1.4s;width:min(76vw,320px)}
.photo.in{transform:rotate(-1.2deg);opacity:1}
.photo img{display:block;width:100%;height:auto}
.ln{opacity:0;transform:translateY(12px);transition:opacity 1.4s,transform 1.4s}.ln.in{opacity:1;transform:none}
.big{font-family:var(--serif);font-size:clamp(2rem,9vw,2.8rem);font-weight:600;line-height:1.15;margin:30px 0 12px}
.txt{font-size:1.08rem;line-height:1.65;margin:12px 0}
.sig{font-family:var(--serif);font-style:italic;font-size:1.6rem;margin:18px 0 6px}
.wv{display:flex;gap:5px;align-items:center;justify-content:center;height:34px;margin:12px 0 4px}
.wv i{width:5px;height:8px;border-radius:3px;background:var(--sage2);transition:height .3s}
.playing .wv i{animation:wv 1.1s ease-in-out infinite}
.wv i:nth-child(2n){animation-delay:.2s!important}.wv i:nth-child(3n){animation-delay:.45s!important}
@keyframes wv{50%{height:30px}}
.eta{margin-top:12px;font-size:.95rem}
.hrt{display:block;width:58px;height:58px;margin:6px auto 0;fill:#d9a79a;filter:drop-shadow(0 4px 6px rgba(150,80,60,.3));transform-origin:50% 55%}
.playing .hrt{animation:bt 1.05s ease-in-out infinite}
@keyframes bt{0%,60%,100%{transform:scale(1)}12%{transform:scale(1.14)}28%{transform:scale(1.02)}40%{transform:scale(1.09)}}
#zoom{position:fixed;inset:0;background:rgba(40,30,15,.88);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px}
#zoom[hidden]{display:none}
#zoom img{max-width:100%;max-height:100%;border-radius:3px}
.rm *{animation:none!important;transition-duration:.01s!important}
.rm .photo{transform:none}.rm .bx.gone{transform:none}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style></head><body>
<div class="glow"></div>
<div class="tools"><button class="tool" id="snd" aria-pressed="true">🔊 Som</button><button class="tool" id="rmb" aria-pressed="false">Menos movimento</button></div>

<main>
<section class="scr" id="intro">
 <div style="position:relative;height:min(52vw,230px);width:min(58vw,250px);margin-bottom:6vh"><div class="bx" id="iboxw" style="pointer-events:none;position:relative;--s:100%;width:100%;height:100%"></div></div>
 <h1>Uma surpresa para você, com todo o nosso carinho.</h1>
 <p class="lead">Queríamos te contar pessoalmente, mas nem sempre dá. Então preparamos um jeitinho de a novidade chegar até você.</p>
 <button class="btn" id="start">Abrir a surpresa</button>
 <p class="hint">Abra com calma, num momento só seu. A última caixinha tem som.</p>
</section>
<section class="scr hide" id="stage" aria-live="polite"><div class="world" id="world"></div><div class="card" id="card" role="group"><p id="ct"></p><small id="cs"></small><button class="btn" id="cb"></button></div></section>
<section id="rev" aria-label="Revelação"><div class="wrap">
 <button class="photo" id="ph" aria-label="Ampliar a foto"><img id="pimg" alt="Nossa foto guardada na caixinha"></button>
 <h2 class="big ln" id="l1">Vamos ter um bebê! ❤️</h2>
 <p class="txt ln" id="l2">Tem um amor pequenininho crescendo aqui… e a gente não via a hora de dividir essa notícia com você.</p>
 <p class="txt ln" id="l3">Prepare o colo e os abraços. Nosso presente mais especial ainda está a caminho.</p>
 <div class="ln" id="aud"><svg class="hrt" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.3 2.7 4.5 6.3 4.5c2.1 0 3.9 1.2 5.7 3.3 1.8-2.1 3.6-3.3 5.7-3.3 3.6 0 5.4 3.8 3.9 7.2C19.5 16.4 12 21 12 21z"/></svg><div class="wv" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><button class="btn ghost" id="hb">Ouvir os batimentos</button></div>
 <p class="eta ln" id="eta" hidden></p>
 <p class="txt ln" id="l4">Você faz parte da nossa história, e a gente queria que soubesse por nós. Gostamos muito de você!</p>
 <p class="sig ln" id="sg"></p>
 <button class="btn ghost ln" id="again" style="min-height:44px;font-size:.9rem;margin-top:10px">Viver a surpresa de novo</button>
</div></section>
</main>
<div id="zoom" hidden><img id="zimg" alt="Foto ampliada"></div>
<audio id="au" preload="auto"></audio>

<script>
/* ===== PERSONALIZE AQUI ===== */
const CONFIG={
 casal:"Vitória e Wildson",
 previsao:"",            // ex.: "Previsão de chegada: março de 2027" (vazio = oculto)
 imagem:"data:image/jpeg;base64,",       // troque pela sua imagem (data: ou URL)
 audio:"data:audio/wav;base64,",      // MP3, M4A ou WAV (vazio = revelação sem som)
 caixinhas:[
  ["Você é uma pessoa especial pra gente, e é por isso que está recebendo esta surpresa.","","Tem mais aqui dentro"],
  ["A parte mais difícil foi guardar segredo e conversar com você como se não tivesse nada acontecendo.","","Que segredo é esse?"],
  ["Agora imagina a gente aí, olhando nos seus olhos e dizendo: ‘Temos uma coisa para te contar…’","Queremos dividir esse momento com você.","Abrir a última caixinha"]
 ]
};
/* ============================ */
function au_init(){document.getElementById('au').loop=true;if(CONFIG.audio)document.getElementById('au').src=CONFIG.audio}
const $=id=>document.getElementById(id),au=$('au'),world=$('world'),card=$('card');
au_init();let i=0,sound=true,busy=false,cur,rt=[];
const wait=ms=>new Promise(r=>setTimeout(r,ms));
function mk(n,cls){const b=document.createElement('button');b.className='bx tiny '+(n%2?'g':'')+' '+(cls||'');b.setAttribute('aria-label',n===2?'Última caixinha':'Abrir a caixinha');
 b.innerHTML='<div class="shadow"></div><div class="body"></div><div class="lid"><div class="bow"><i></i><i></i><b></b></div></div>'+'<span class="tap">toque para abrir</span>';
 b.querySelector('.tap').style.cssText='';world.appendChild(b);return b}
$('iboxw').innerHTML='<div class="shadow"></div><div class="body"></div><div class="lid"><div class="bow"><i></i><i></i><b></b></div></div>';
$('iboxw').classList.remove('tiny');$('iboxw').style.opacity=1;
function show(b){b.classList.remove('tiny');b.classList.add('peek');b.style.opacity=1}
async function arm(){cur=mk(i);cur.classList.add('peek');void cur.offsetWidth;cur.classList.remove('tiny');cur.style.opacity=1;cur.onclick=openBox}
async function openBox(){if(busy)return;busy=true;cur.onclick=null;const t=cur.querySelector('.tap');if(t)t.style.opacity=0;
 cur.classList.add('open');await wait(450);
 const c=CONFIG.caixinhas[i];$('ct').textContent=c[0];$('cs').textContent=c[1];$('cs').hidden=!c[1];$('cb').textContent=c[2];
 card.classList.add('show');busy=false;$('cb').focus({preventScroll:true})}
$('cb').onclick=async()=>{if(busy)return;busy=true;if(i===2&&sound&&CONFIG.audio){au.muted=false;if(au.paused)play()}card.classList.remove('show');await wait(300);
 if(i<2){const old=cur;i++;const nx=mk(i);nx.classList.add('peek');nx.style.opacity=1;void nx.offsetWidth;old.classList.add('gone');nx.classList.remove('tiny');cur=nx;await wait(800);old.remove();nx.onclick=openBox;busy=false;nx.focus({preventScroll:true})}
 else{await finale()}};
async function finale(){const old=cur;old.classList.add('gone');await wait(650);$('stage').classList.add('hide');
 $('pimg').src=CONFIG.imagem;$('sg').textContent=CONFIG.casal;
 if(CONFIG.previsao){$('eta').textContent=CONFIG.previsao;$('eta').hidden=false}
 if(!CONFIG.audio)$('aud').hidden=true;
 await wait(400);document.body.classList.add('warm');$('rev').classList.add('on');$('rev').scrollTop=0;
 const seq=['ph','l1','l2','l3','aud','eta','l4','sg','again'];
 if(sound&&CONFIG.audio){au.muted=false;if(au.paused)play()}await wait(500);$('ph').classList.add('in');await wait(1500);
 for(const id of seq.slice(1)){const e=$(id);if(e.hidden)continue;e.classList.add('in');if(id==='l1'||id==='l2')await wait(1600);else await wait(id==='aud'?300:1200);
  }
 busy=false}
function play(){au.currentTime=0;au.volume=1;const p=au.play();if(p)p.catch(()=>{})}
au.onplay=()=>$('aud').classList.add('playing');au.onpause=au.onended=()=>$('aud').classList.remove('playing');
$('hb').onclick=()=>{au.muted=false;play()};
$('snd').onclick=e=>{sound=!sound;e.target.setAttribute('aria-pressed',sound);e.target.textContent=sound?'🔊 Som':'🔇 Sem som';if(!sound)au.muted=true;else if($('rev').classList.contains('on')&&CONFIG.audio){au.muted=false;if(au.paused)play()}};
$('rev').addEventListener('pointerdown',()=>{if(sound&&CONFIG.audio&&(au.paused||au.muted)){au.muted=false;if(au.paused)play()}});
$('rmb').onclick=e=>{const on=document.body.classList.toggle('rm');e.target.setAttribute('aria-pressed',on)};
$('start').onclick=async()=>{au.muted=true;au.loop=true;try{await au.play()}catch(e){}
 busy=true;$('intro').classList.add('hide');$('stage').classList.remove('hide');await wait(300);await arm();busy=false};
$('ph').onclick=()=>{$('zimg').src=CONFIG.imagem;$('zoom').hidden=false};
$('zoom').onclick=()=>{$('zoom').hidden=true};
document.addEventListener('keydown',e=>{if(e.key==='Escape')$('zoom').hidden=true});
$('again').onclick=()=>location.reload();
if(matchMedia('(prefers-reduced-motion:reduce)').matches)document.body.classList.add('rm');
</script></body></html>
